        "arm": {
          "title": "Arm",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "target_total": {
          "title": "Target Total",
          "type": "integer"
        },
        "target_passed": {
          "title": "Target Passed",
          "type": "integer"
        },
        "regression_total": {
          "title": "Regression Total",
          "type": "integer"
        },
        "regression_passed": {
          "title": "Regression Passed",
          "type": "integer"
