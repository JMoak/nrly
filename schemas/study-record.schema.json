        "arm",
        "status",
        "complete",
        "total",
        "passed",
        "target_total",
        "target_passed",
        "regression_total",
        "regression_passed"
      ],
      "title": "ArmSummary",
      "type": "object"
    },
    "BudgetSpec": {
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Wall Seconds",
          "type": "number"
        },
        "max_cases": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Cases",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 4096,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_capture_bytes": {
          "default": 262144,
          "maximum": 100000000,
          "minimum": 0,
          "title": "Max Capture Bytes",
          "type": "integer"
        }
      },
      "title": "BudgetSpec",
      "type": "object"
    },
    "CandidateSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "program": {
          "$ref": "#/$defs/ProgramSpec"
        }
      },
      "required": [
        "name",
        "program"
      ],
      "title": "CandidateSpec",
      "type": "object"
    },
    "CaseSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "scorer": {
          "default": "exact",
          "enum": [
            "exact",
            "numeric",
            "final_number"
          ],
          "title": "Scorer",
          "type": "string"
        },
        "tolerance": {
          "default": 1e-06,
          "maximum": 1,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "split": {
          "default": "discovery",
          "enum": [
            "discovery",
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        },
        "role": {
          "default": "target",
          "enum": [
            "target",
            "regression"
          ],
          "title": "Role",
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "maxItems": 128,
          "title": "Messages",
          "type": "array"
        },
        "continuation": {
          "anyOf": [
            {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation"
        },
        "group": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "adapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskAdapterSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "title": "CaseSpec",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "ComparatorSpec": {
      "additionalProperties": false,
      "description": "Operator-registered alternative; an external checkpoint may be fine-tuned elsewhere.",
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "prompt",
            "model"
          ],
          "title": "Kind",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "maxLength": 10000,
          "title": "Prefix",
          "type": "string"
        },
        "suffix": {
          "default": "",
          "maxLength": 10000,
          "title": "Suffix",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "ComparatorSpec",
      "type": "object"
    },
    "GenerationSpec": {
      "additionalProperties": false,
      "properties": {
        "max_new_tokens": {
          "default": 32,
          "maximum": 32768,
          "minimum": 1,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "seed": {
          "default": 0,
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "enable_thinking": {
          "default": false,
          "title": "Enable Thinking",
          "type": "boolean"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "top_k": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        },
        "min_new_tokens": {
          "anyOf": [
            {
              "maximum": 32768,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min New Tokens"
        },
        "repetition_penalty": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repetition Penalty"
        }
      },
      "title": "GenerationSpec",
      "type": "object"
    },
    "HoldoutCommitment": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "targets": {
          "title": "Targets",
