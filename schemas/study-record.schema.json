          "title": "Kind",
          "type": "string"
        },
        "expected_base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Base"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/WeightOperationSpec"
          },
          "maxItems": 32,
          "title": "Operations",
          "type": "array"
        }
      },
      "title": "ProgramSpec",
      "type": "object"
    },
    "SeedVariation": {
      "additionalProperties": false,
      "description": "Descriptive paired variation, never an independence or population CI claim.",
