          "title": "Interpretation",
          "type": "string"
        }
      },
      "required": [
        "seed_count",
        "cases_per_seed",
        "paired_executions",
        "mean_delta",
        "sample_stddev",
        "minimum_delta",
        "maximum_delta"
      ],
      "title": "SeedVariation",
      "type": "object"
    },
    "StudyAssessment": {
