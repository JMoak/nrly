    "ProgramSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Values",
          "type": "array"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Shape",
          "type": "array"
        },
        "indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Indices",
          "type": "array"
        },
        "position": {
          "default": "all",
          "enum": [
            "all",
            "last"
          ],
          "title": "Position",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Right",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/TensorSlice"
