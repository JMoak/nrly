          "type": "array"
        },
        "kind": {
          "default": "identity",
          "enum": [
            "identity",
            "activation_scale",
            "activation_add",
            "weight_scale",
            "weight_replace",
            "weight_patch",
            "weight_add",
            "weight_sparse_add",
            "weight_low_rank",
            "weight_slice_scale",
            "pipeline"
