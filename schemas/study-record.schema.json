        "seed_count": {
          "title": "Seed Count",
          "type": "integer"
        },
        "cases_per_seed": {
          "title": "Cases Per Seed",
          "type": "integer"
        },
        "paired_executions": {
          "title": "Paired Executions",
          "type": "integer"
        },
        "mean_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Delta"
        },
        "sample_stddev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Stddev"
