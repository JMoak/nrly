{
  "$defs": {
    "ArmSummary": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "title": "Arm",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "target_total": {
          "title": "Target Total",
          "type": "integer"
        },
        "target_passed": {
          "title": "Target Passed",
          "type": "integer"
        },
        "regression_total": {
          "title": "Regression Total",
          "type": "integer"
        },
        "regression_passed": {
          "title": "Regression Passed",
          "type": "integer"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/StudyGroupSummary"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "arm",
        "status",
        "complete",
        "total",
        "passed",
        "target_total",
        "target_passed",
        "regression_total",
        "regression_passed"
      ],
      "title": "ArmSummary",
      "type": "object"
    },
    "CandidateSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "program": {
          "$ref": "#/$defs/ProgramSpec"
        }
      },
      "required": [
        "name",
        "program"
      ],
      "title": "CandidateSpec",
      "type": "object"
    },
    "PairedGroupSummary": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "title": "Group",
          "type": "string"
        },
        "improved": {
          "title": "Improved",
          "type": "integer"
        },
        "regressed": {
          "title": "Regressed",
          "type": "integer"
        },
        "unchanged": {
          "title": "Unchanged",
          "type": "integer"
        },
        "variation": {
          "$ref": "#/$defs/SeedVariation"
        }
      },
      "required": [
        "group",
        "improved",
        "regressed",
        "unchanged",
        "variation"
      ],
      "title": "PairedGroupSummary",
      "type": "object"
    },
    "PairedSummary": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "comparable": {
          "title": "Comparable",
          "type": "boolean"
        },
        "improved_targets": {
          "default": 0,
          "title": "Improved Targets",
          "type": "integer"
        },
        "regressed_targets": {
          "default": 0,
          "title": "Regressed Targets",
          "type": "integer"
        },
        "improved_regressions": {
          "default": 0,
          "title": "Improved Regressions",
          "type": "integer"
        },
        "regressed_regressions": {
          "default": 0,
          "title": "Regressed Regressions",
          "type": "integer"
        },
        "target_variation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeedVariation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regression_variation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeedVariation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/PairedGroupSummary"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "reference",
        "comparable"
      ],
      "title": "PairedSummary",
      "type": "object"
    },
    "ProgramSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Values",
          "type": "array"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Shape",
          "type": "array"
        },
        "indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Indices",
          "type": "array"
        },
        "position": {
          "default": "all",
          "enum": [
            "all",
            "last"
          ],
          "title": "Position",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Right",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/TensorSlice"
          },
          "maxItems": 8,
          "title": "Slices",
          "type": "array"
        },
        "kind": {
          "default": "identity",
          "enum": [
            "identity",
            "activation_scale",
            "activation_add",
            "weight_scale",
            "weight_replace",
            "weight_patch",
            "weight_add",
            "weight_sparse_add",
            "weight_low_rank",
            "weight_slice_scale",
            "pipeline"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expected_base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Base"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/WeightOperationSpec"
          },
          "maxItems": 32,
          "title": "Operations",
          "type": "array"
        }
      },
      "title": "ProgramSpec",
      "type": "object"
    },
    "SeedVariation": {
      "additionalProperties": false,
      "description": "Descriptive paired variation, never an independence or population CI claim.",
      "properties": {
        "seed_count": {
          "title": "Seed Count",
          "type": "integer"
        },
        "cases_per_seed": {
          "title": "Cases Per Seed",
          "type": "integer"
        },
        "paired_executions": {
          "title": "Paired Executions",
          "type": "integer"
        },
        "mean_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mean Delta"
        },
        "sample_stddev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Stddev"
        },
        "minimum_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum Delta"
        },
        "maximum_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum Delta"
        },
        "interpretation": {
          "const": "descriptive_across_registered_seeds_not_population_ci",
          "default": "descriptive_across_registered_seeds_not_population_ci",
          "title": "Interpretation",
          "type": "string"
        }
      },
      "required": [
        "seed_count",
        "cases_per_seed",
        "paired_executions",
        "mean_delta",
        "sample_stddev",
        "minimum_delta",
        "maximum_delta"
      ],
      "title": "SeedVariation",
      "type": "object"
    },
    "StudyAssessment": {
      "additionalProperties": false,
      "properties": {
        "scorer_version": {
          "anyOf": [
            {
              "const": "nrly-scorers/2",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scorer Version"
        },
        "verdict": {
          "enum": [
            "observed_improvement",
            "no_change",
            "regressed",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "recommendation": {
          "default": "retain_original",
          "enum": [
            "retain_original",
            "candidate_supported"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "scope": {
          "enum": [
            "engineering_fixture",
            "real_model"
          ],
          "title": "Scope",
          "type": "string"
        },
        "arms": {
          "items": {
            "$ref": "#/$defs/ArmSummary"
          },
          "title": "Arms",
          "type": "array"
        },
        "comparisons": {
          "items": {
            "$ref": "#/$defs/PairedSummary"
          },
          "title": "Comparisons",
          "type": "array"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "scope"
      ],
      "title": "StudyAssessment",
      "type": "object"
    },
    "StudyGroupSummary": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "title": "Group",
          "type": "string"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "integer"
        },
        "unscored": {
          "title": "Unscored",
          "type": "integer"
        }
      },
      "required": [
        "group",
        "total",
        "passed",
        "unscored"
      ],
      "title": "StudyGroupSummary",
      "type": "object"
    },
    "TensorSlice": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "stop": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Stop",
          "type": "integer"
        },
        "step": {
          "default": 1,
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "stop"
      ],
      "title": "TensorSlice",
      "type": "object"
    },
    "WeightOperationSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Values",
          "type": "array"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Shape",
          "type": "array"
        },
        "indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Indices",
          "type": "array"
        },
        "position": {
          "default": "all",
          "enum": [
            "all",
            "last"
          ],
          "title": "Position",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Right",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/TensorSlice"
          },
          "maxItems": 8,
          "title": "Slices",
          "type": "array"
        },
        "kind": {
          "enum": [
            "weight_scale",
            "weight_replace",
            "weight_patch",
            "weight_add",
            "weight_sparse_add",
            "weight_low_rank",
            "weight_slice_scale"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WeightOperationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "candidate": {
      "$ref": "#/$defs/CandidateSpec"
    },
    "candidate_digest": {
      "title": "Candidate Digest",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudyAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    }
  },
  "required": [
    "id",
    "study_id",
    "sequence",
    "candidate",
    "candidate_digest",
    "status",
    "created_at"
  ],
  "title": "AttemptRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
