{
  "$defs": {
    "PortableBase": {
      "additionalProperties": false,
      "description": "What a shared artifact pins: exact checkpoint bytes at a load dtype, never a machine.\n\n``ModelIdentity.fingerprint`` also hashes the device, driver and library versions, so\nit identifies one runtime. Evidence pins that fingerprint. Anything meant to travel\nbetween machines pins this record instead, and is bound to the local runtime only\nafter the loaded weights digest has been verified.",
      "properties": {
        "backend": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "dtype": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        },
        "weights_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Weights Sha256",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model_id",
        "revision",
        "dtype",
        "weights_sha256"
      ],
      "title": "PortableBase",
      "type": "object"
    },
    "TensorSlice": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "stop": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Stop",
          "type": "integer"
        },
        "step": {
          "default": 1,
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "stop"
      ],
      "title": "TensorSlice",
      "type": "object"
    },
    "WeightOperationSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Values",
          "type": "array"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Shape",
          "type": "array"
        },
        "indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Indices",
          "type": "array"
        },
        "position": {
          "default": "all",
          "enum": [
            "all",
            "last"
          ],
          "title": "Position",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Right",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/TensorSlice"
          },
          "maxItems": 8,
          "title": "Slices",
          "type": "array"
        },
        "kind": {
          "enum": [
            "weight_scale",
            "weight_replace",
            "weight_patch",
            "weight_add",
            "weight_sparse_add",
            "weight_low_rank",
            "weight_slice_scale"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WeightOperationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A weight edit that pins exact weights at a load dtype and no runtime fingerprint.",
  "properties": {
    "schema_version": {
      "const": "nrly-patch/2",
      "default": "nrly-patch/2",
      "title": "Schema Version",
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/PortableBase"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/WeightOperationSpec"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "base",
    "operations",
    "id"
  ],
  "title": "PortablePatchManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
