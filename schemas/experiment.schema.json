          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "CaptureSpec",
      "type": "object"
    },
    "CaseSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
