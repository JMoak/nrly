        "max_cases": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Cases",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 4096,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_capture_bytes": {
          "default": 262144,
          "maximum": 100000000,
          "minimum": 0,
          "title": "Max Capture Bytes",
          "type": "integer"
        }
      },
      "title": "BudgetSpec",
      "type": "object"
    },
    "CaptureSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
