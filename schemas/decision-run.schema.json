{
  "$defs": {
    "DecisionCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "family": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "split": {
          "enum": [
            "fit",
            "evaluation",
            "challenge"
          ],
          "title": "Split",
          "type": "string"
        },
        "state": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "State",
          "type": "string"
        },
        "truth": {
          "title": "Truth",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "family",
        "split",
        "state",
        "truth"
      ],
      "title": "DecisionCase",
      "type": "object"
    },
    "DecisionExecution": {
      "additionalProperties": false,
      "properties": {
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "base_unchanged": {
          "const": true,
          "default": true,
          "title": "Base Unchanged",
          "type": "boolean"
        },
        "weight_changes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WeightChange"
          },
          "maxItems": 64,
          "title": "Weight Changes",
          "type": "array"
        }
      },
      "required": [
        "probability",
        "elapsed_ms"
      ],
      "title": "DecisionExecution",
      "type": "object"
    },
    "DecisionFreeze": {
      "additionalProperties": false,
      "properties": {
        "protocol_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Digest",
          "type": "string"
        },
        "identity_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Digest",
          "type": "string"
        },
        "program_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Program Digest",
          "type": "string"
        },
        "semantics": {
          "enum": [
            "native_binary_probability",
            "causal_label_likelihood"
          ],
          "title": "Semantics",
          "type": "string"
        },
        "execution_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Identity",
          "type": "string"
        },
        "original_rule": {
          "$ref": "#/$defs/FrozenRule"
        },
        "patch_rule": {
          "$ref": "#/$defs/FrozenRule"
        }
      },
      "required": [
        "protocol_digest",
        "identity_digest",
        "program_digest",
        "semantics",
        "execution_identity",
        "original_rule",
        "patch_rule"
      ],
      "title": "DecisionFreeze",
      "type": "object"
    },
    "DecisionObservation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "variant": {
          "enum": [
            "original",
            "patch"
          ],
          "title": "Variant",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "program_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Program Digest",
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionExecution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "execution_failed",
                "budget_exceeded",
                "restoration_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "case_id",
        "variant",
        "input_digest",
        "program_digest"
      ],
      "title": "DecisionObservation",
      "type": "object"
    },
    "DecisionProtocol": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "nrly-decision-protocol/1",
          "default": "nrly-decision-protocol/1",
          "title": "Schema Version",
          "type": "string"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "label_origin": {
          "enum": [
            "synthetic",
            "assistant_authored",
            "independently_reviewed"
          ],
          "title": "Label Origin",
          "type": "string"
        },
        "evaluation_scope": {
          "const": "exploratory",
          "default": "exploratory",
          "title": "Evaluation Scope",
          "type": "string"
        },
        "fixed_threshold": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Fixed Threshold",
          "type": "number"
        },
        "threshold_grid": {
          "default": [
            0.5,
            0.6,
            0.7,
            0.8,
            0.9,
            0.95,
            0.99
          ],
          "items": {
            "type": "number"
          },
          "maxItems": 101,
          "minItems": 1,
          "title": "Threshold Grid",
          "type": "array"
        },
        "max_unsupported_rate": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Unsupported Rate",
          "type": "number"
        },
        "min_fit_acts": {
          "default": 2,
          "maximum": 1000,
          "minimum": 1,
          "title": "Min Fit Acts",
          "type": "integer"
        },
        "min_fit_families": {
          "default": 2,
          "maximum": 1000,
          "minimum": 2,
          "title": "Min Fit Families",
          "type": "integer"
        },
        "max_elapsed_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Max Elapsed Seconds",
          "type": "number"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/DecisionCase"
          },
          "maxItems": 1000,
          "minItems": 4,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "question",
        "label_origin",
        "cases"
      ],
      "title": "DecisionProtocol",
      "type": "object"
    },
    "FrozenRule": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "empirical-coverage-grid/1",
          "default": "empirical-coverage-grid/1",
          "title": "Method",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "fit_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fit Digest",
          "type": "string"
        }
      },
      "required": [
        "fit_digest"
      ],
      "title": "FrozenRule",
      "type": "object"
    },
    "JsonValue": {},
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "backend",
        "model_id",
        "revision",
        "fingerprint"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "ProgramSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Values",
          "type": "array"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Shape",
          "type": "array"
        },
        "indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Indices",
          "type": "array"
        },
        "position": {
          "default": "all",
          "enum": [
            "all",
            "last"
          ],
          "title": "Position",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Right",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/TensorSlice"
          },
          "maxItems": 8,
          "title": "Slices",
          "type": "array"
        },
        "kind": {
          "default": "identity",
          "enum": [
            "identity",
            "activation_scale",
            "activation_add",
            "weight_scale",
            "weight_replace",
            "weight_patch",
            "weight_add",
            "weight_sparse_add",
            "weight_low_rank",
            "weight_slice_scale",
            "pipeline"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expected_base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Base"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/WeightOperationSpec"
          },
          "maxItems": 32,
          "title": "Operations",
          "type": "array"
        }
      },
      "title": "ProgramSpec",
      "type": "object"
    },
    "TensorSlice": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "stop": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Stop",
          "type": "integer"
        },
        "step": {
          "default": 1,
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        }
      },
      "required": [
        "stop"
      ],
      "title": "TensorSlice",
      "type": "object"
    },
    "WeightChange": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "before_sha256": {
          "title": "Before Sha256",
          "type": "string"
        },
        "after_sha256": {
          "title": "After Sha256",
          "type": "string"
        },
        "changed_elements": {
          "minimum": 0,
          "title": "Changed Elements",
          "type": "integer"
        },
        "total_elements": {
          "minimum": 0,
          "title": "Total Elements",
          "type": "integer"
        },
        "before_preview": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "title": "Before Preview",
          "type": "array"
        },
        "after_preview": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "title": "After Preview",
          "type": "array"
        },
        "edited_indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Edited Indices",
          "type": "array"
        },
        "edited_before": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "title": "Edited Before",
          "type": "array"
        },
        "edited_after": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "title": "Edited After",
          "type": "array"
        },
        "operation_index": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Index"
        },
        "operation_kind": {
          "anyOf": [
            {
              "enum": [
                "weight_scale",
                "weight_replace",
                "weight_patch",
                "weight_add",
                "weight_sparse_add",
                "weight_low_rank",
                "weight_slice_scale"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Kind"
        },
        "edited_coordinates": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "maxItems": 32,
          "title": "Edited Coordinates",
          "type": "array"
        },
        "net_changed_elements": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net Changed Elements"
        },
        "net_before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net Before Sha256"
        },
        "net_after_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net After Sha256"
        }
      },
      "required": [
        "target",
        "shape",
        "dtype",
        "before_sha256",
        "after_sha256",
        "changed_elements",
        "total_elements"
      ],
      "title": "WeightChange",
      "type": "object"
    },
    "WeightOperationSpec": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Values",
          "type": "array"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Shape",
          "type": "array"
        },
        "indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Indices",
          "type": "array"
        },
        "position": {
          "default": "all",
          "enum": [
            "all",
            "last"
          ],
          "title": "Position",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 256,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "left": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Left",
          "type": "array"
        },
        "right": {
          "items": {
            "type": "number"
          },
          "maxItems": 65536,
          "title": "Right",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/TensorSlice"
          },
          "maxItems": 8,
          "title": "Slices",
          "type": "array"
        },
        "kind": {
          "enum": [
            "weight_scale",
            "weight_replace",
            "weight_patch",
            "weight_add",
            "weight_sparse_add",
            "weight_low_rank",
            "weight_slice_scale"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WeightOperationSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "nrly-decision-run/1",
      "default": "nrly-decision-run/1",
      "title": "Schema Version",
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/DecisionProtocol"
    },
    "identity": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "program": {
      "$ref": "#/$defs/ProgramSpec"
    },
    "freeze": {
      "$ref": "#/$defs/DecisionFreeze"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "number"
    },
    "budget_exceeded": {
      "default": false,
      "title": "Budget Exceeded",
      "type": "boolean"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/DecisionObservation"
      },
      "maxItems": 2000,
      "minItems": 8,
      "title": "Observations",
      "type": "array"
    }
  },
  "required": [
    "protocol",
    "identity",
    "program",
    "freeze",
    "elapsed_ms",
    "observations"
  ],
  "title": "DecisionRun",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
